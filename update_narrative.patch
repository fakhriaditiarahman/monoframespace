 // ---- SCENE 2: THE NARRATIVE (SCROLL-DRIVEN TEXT REVEAL) ----
+/*
+  ⚡ Bolt Optimization:
+  - Moved `text` and `words` outside of the NarrativeScene component to prevent expensive recalculation (e.g., text.split(" ")) on every render, significantly reducing garbage collection overhead.
+*/
+const narrativeText = "Di Monoframe, kami percaya bahwa setiap momen, baris kode, dan pixel memiliki cerita. Kami menggabungkan seni visual dengan keunggulan teknis untuk menciptakan pengalaman digital yang tak terlupakan."
+const narrativeWords = narrativeText.split(" ")
+
+/*
+  ⚡ Bolt Optimization:
+  - Extracted the mapped iteration into a separate functional component `NarrativeWord`.
+  - Calling `useTransform` inside an array `.map()` loop within `NarrativeScene`'s render function is a strict violation of React's Rules of Hooks.
+  - This extraction ensures hooks comply with the rules and maintain hook order stability.
+*/
+function NarrativeWord({ word, index, totalWords, scrollYProgress }: { word: string, index: number, totalWords: number, scrollYProgress: any }) {
+  const start = index / totalWords
+  const end = start + (1 / totalWords)
+  const opacity = useTransform(scrollYProgress, [start, end], [0.1, 1])
+  return (
+    <motion.span style={{ opacity }} className="text-blue-950">
+      {word}
+    </motion.span>
+  )
+}
