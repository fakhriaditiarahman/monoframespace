+// ⚡ Bolt Optimization:
+// 1. Moved static text definitions outside the component to prevent recreating the string and array on every render.
+//    This reduces garbage collection pressure in a scroll-heavy scene.
+// 2. Extracted the map body into a separate functional component `NarrativeWord` to comply with React's Rules of Hooks.
+//    Previously, `useTransform` was called inside an array `.map()`, which is an anti-pattern and can cause hook order instability.
+
+const NARRATIVE_TEXT = "Di Monoframe, kami percaya bahwa setiap momen, baris kode, dan pixel memiliki cerita. Kami menggabungkan seni visual dengan keunggulan teknis untuk menciptakan pengalaman digital yang tak terlupakan."
+const NARRATIVE_WORDS = NARRATIVE_TEXT.split(" ")
+const TOTAL_WORDS = NARRATIVE_WORDS.length
+
+function NarrativeWord({ word, index, scrollYProgress }: { word: string, index: number, scrollYProgress: any }) {
+  const start = index / TOTAL_WORDS
+  const end = start + (1 / TOTAL_WORDS)
+  const opacity = useTransform(scrollYProgress, [start, end], [0.1, 1])
+
+  return (
+    <motion.span style={{ opacity }} className="text-blue-950">
+      {word}
+    </motion.span>
+  )
+}
