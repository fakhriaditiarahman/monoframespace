+// ⚡ Bolt Optimization: Moved static variables outside the component
+// - Prevents re-evaluating text.split(" ") on every render, reducing garbage collection pressure
+const NARRATIVE_TEXT = "Di Monoframe, kami percaya bahwa setiap momen, baris kode, dan pixel memiliki cerita. Kami menggabungkan seni visual dengan keunggulan teknis untuk menciptakan pengalaman digital yang tak terlupakan."
+const NARRATIVE_WORDS = NARRATIVE_TEXT.split(" ")
+
+// ⚡ Bolt Optimization: Extracted word rendering into a separate component
+// - Fixes React Hook violation: hooks (useTransform) cannot be called inside a .map() loop
+// - Improves render performance and hook stability
+import { MotionValue } from "framer-motion"
+
+function NarrativeWord({
+  word,
+  index,
+  totalWords,
+  scrollYProgress
+}: {
+  word: string;
+  index: number;
+  totalWords: number;
+  scrollYProgress: MotionValue<number>;
+}) {
+  const start = index / totalWords
+  const end = start + (1 / totalWords)
+  const opacity = useTransform(scrollYProgress, [start, end], [0.1, 1])
+
+  return (
+    <motion.span style={{ opacity }} className="text-blue-950">
+      {word}
+    </motion.span>
+  )
+}
